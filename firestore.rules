rules_version = '2';

// Firestore security rules for the club-app-8f954 project.
//
// Access model (2026-09): the club owner signs in to the admin app with
// email/password (isAdmin() below) and is the only one who can list, read or
// delete data. Public pages (register.html, user.html) use an anonymous session
// and can only: read ONE member by id, self-register, change their own photo,
// look up/claim a phone number in the phones index, read their own
// members/{id}/checkins history, and read the promotions list.
//
// What THIS file adds: every `create`/`update` is validated against the
// exact field shapes the app actually writes, so a request that doesn't
// come through the app's own UI (e.g. a raw API call) can no longer:
//   - set a document's `id` field to anything other than its own doc key
//     (this field is what several onclick handlers embed into inline JS —
//     letting it diverge from the doc key was a second-order injection risk)
//   - set balance/vipSlots/quantity/amount/count to a non-numeric or
//     out-of-range value
//   - set `photo` to anything other than a real base64 image data URL
//   - inject arbitrary extra fields onto a brand-new document
//
// Updates are validated leniently (only the fields a given write actually
// changes are checked, via diff().affectedKeys()) specifically so a
// legitimate small edit (e.g. just updating `balance`) can never be
// rejected because of some unrelated, pre-existing field already sitting
// on that document — this trades a little strictness for not risking
// breakage of real, already-stored records.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The club owner: signed in with email/password (not anonymous) as this address.
    // Sign-up by strangers cannot claim it, because the account already exists.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'info@av.co.il';
    }

    // The app always writes dates as plain JS strings (new Date().toISOString()),
    // but Firestore itself can also hold a native Timestamp type for the same kind
    // of value — accepting either avoids rejecting a legitimate write just because
    // of which of the two equivalent representations it happens to use.
    function isDateish(v) {
      return v is timestamp || v is string;
    }
    function isDateishBounded(v, maxLen) {
      return v is timestamp || (v is string && v.size() < maxLen);
    }

    // ---------------- members ----------------
    function memberCreateOk(d, memberId) {
      return d.keys().hasOnly(['id','name','phone','email','birthDate','photo','balance','vipSlots','nfcTag','createdAt','registeredSelf','lastBirthdayCheckinWeek'])
        && d.id is string && d.id == memberId
        && d.name is string && d.name.size() > 0 && d.name.size() < 120
        && (!('phone' in d) || (d.phone is string && d.phone.size() < 40))
        && (!('email' in d) || (d.email is string && d.email.size() < 200))
        && (!('birthDate' in d) || isDateishBounded(d.birthDate, 20))
        && (!('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() < 900000 && d.photo.matches('^data:image/(png|jpe?g|gif|webp);base64,[A-Za-z0-9+/]+=*$')))
        && (!('balance' in d) || (d.balance is number && d.balance >= 0 && d.balance < 100000))
        && (!('vipSlots' in d) || (d.vipSlots is number && d.vipSlots in [0,1,2]))
        && (!('nfcTag' in d) || d.nfcTag == null || (d.nfcTag is string && d.nfcTag.size() < 500))
        && (!('createdAt' in d) || isDateishBounded(d.createdAt, 40))
        && (!('registeredSelf' in d) || d.registeredSelf is bool)
        && (!('lastBirthdayCheckinWeek' in d) || isDateishBounded(d.lastBirthdayCheckinWeek, 20));
    }

    function memberUpdateOk(newData, oldData, memberId) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['id']) || (newData.id is string && newData.id == memberId))
        && (!changed.hasAny(['name']) || (newData.name is string && newData.name.size() > 0 && newData.name.size() < 120))
        && (!changed.hasAny(['phone']) || (newData.phone is string && newData.phone.size() < 40))
        && (!changed.hasAny(['email']) || (newData.email is string && newData.email.size() < 200))
        && (!changed.hasAny(['birthDate']) || isDateishBounded(newData.birthDate, 20))
        && (!changed.hasAny(['photo']) || newData.photo == null || (newData.photo is string && newData.photo.size() < 900000 && newData.photo.matches('^data:image/(png|jpe?g|gif|webp);base64,[A-Za-z0-9+/]+=*$')))
        && (!changed.hasAny(['balance']) || (newData.balance is number && newData.balance >= 0 && newData.balance < 100000))
        && (!changed.hasAny(['vipSlots']) || (newData.vipSlots is number && newData.vipSlots in [0,1,2]))
        && (!changed.hasAny(['nfcTag']) || newData.nfcTag == null || (newData.nfcTag is string && newData.nfcTag.size() < 500))
        && (!changed.hasAny(['registeredSelf']) || newData.registeredSelf is bool)
        && (!changed.hasAny(['lastBirthdayCheckinWeek']) || isDateishBounded(newData.lastBirthdayCheckinWeek, 20));
    }

    // Public (anonymous) visitors can: read ONE member by id (their own card link),
    // self-register (balance 0, no VIP/NFC), and change only their own photo.
    // Only the admin can list, delete, or change anything else.
    match /members/{memberId} {
      allow get: if signedIn();
      allow list, delete: if isAdmin();
      allow create: if isAdmin() && memberCreateOk(request.resource.data, memberId)
        || signedIn() && memberCreateOk(request.resource.data, memberId)
           && request.resource.data.registeredSelf == true
           && request.resource.data.get('balance', 0) == 0
           && !('vipSlots' in request.resource.data)
           && !('nfcTag' in request.resource.data);
      allow update: if isAdmin() && memberUpdateOk(request.resource.data, resource.data, memberId)
        || signedIn() && memberUpdateOk(request.resource.data, resource.data, memberId)
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo']);

      // A member's own check-in history (copy of top-level checkins, written by the admin app).
      match /checkins/{checkinId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // Duplicate-phone index used by register.html: anyone can look up / claim a phone
    // number once; only the admin can change or remove entries.
    match /phones/{phoneKey} {
      allow get: if signedIn();
      allow create: if signedIn() && phoneKey.size() <= 20
        && request.resource.data.keys().hasOnly(['memberId','createdAt'])
        && request.resource.data.memberId is string;
      allow list, update, delete: if isAdmin();
    }

    // ---------------- payments ----------------
    function paymentCreateOk(d, paymentId) {
      return d.keys().hasOnly(['id','memberId','quantity','amount','paymentMethod','note','terminal','date'])
        && d.id is string && d.id == paymentId
        && d.memberId is string
        && d.quantity is number && d.quantity > 0 && d.quantity <= 1000
        && d.amount is number && d.amount >= 0 && d.amount <= 100000
        && (!('paymentMethod' in d) || d.paymentMethod in ['cash','credit'])
        && (!('note' in d) || (d.note is string && d.note.size() < 500))
        && (!('terminal' in d) || (d.terminal is string && d.terminal.size() < 100))
        && isDateish(d.date);
    }

    function paymentUpdateOk(newData, oldData, paymentId) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['id']) || (newData.id is string && newData.id == paymentId))
        && (!changed.hasAny(['memberId']) || newData.memberId is string)
        && (!changed.hasAny(['quantity']) || (newData.quantity is number && newData.quantity > 0 && newData.quantity <= 1000))
        && (!changed.hasAny(['amount']) || (newData.amount is number && newData.amount >= 0 && newData.amount <= 100000))
        && (!changed.hasAny(['paymentMethod']) || newData.paymentMethod in ['cash','credit'])
        && (!changed.hasAny(['note']) || (newData.note is string && newData.note.size() < 500))
        && (!changed.hasAny(['terminal']) || (newData.terminal is string && newData.terminal.size() < 100));
    }

    match /payments/{paymentId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && paymentCreateOk(request.resource.data, paymentId);
      allow update: if isAdmin() && paymentUpdateOk(request.resource.data, resource.data, paymentId);
    }

    // ---------------- checkins ----------------
    function checkinCreateOk(d, checkinId) {
      return d.keys().hasOnly(['id','memberId','entryType','terminal','timestamp'])
        && d.id is string && d.id == checkinId
        && d.memberId is string
        && d.entryType in ['single','couple','birthday','vip-single','vip-couple']
        && (!('terminal' in d) || (d.terminal is string && d.terminal.size() < 100))
        && isDateish(d.timestamp);
    }

    function checkinUpdateOk(newData, oldData, checkinId) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['id']) || (newData.id is string && newData.id == checkinId))
        && (!changed.hasAny(['memberId']) || newData.memberId is string)
        && (!changed.hasAny(['entryType']) || newData.entryType in ['single','couple','birthday','vip-single','vip-couple'])
        && (!changed.hasAny(['terminal']) || (newData.terminal is string && newData.terminal.size() < 100));
    }

    match /checkins/{checkinId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && checkinCreateOk(request.resource.data, checkinId);
      allow update: if isAdmin() && checkinUpdateOk(request.resource.data, resource.data, checkinId);
    }

    // ---------------- guests (temporary, 48h) ----------------
    function guestCreateOk(d, guestId) {
      return d.keys().hasOnly(['id','name','slots','createdAt','expiresAt'])
        && d.id is string && d.id == guestId
        && d.name is string && d.name.size() > 0 && d.name.size() < 120
        && d.slots is number && d.slots in [1,2]
        && isDateish(d.createdAt)
        && isDateish(d.expiresAt);
    }

    function guestUpdateOk(newData, oldData, guestId) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['id']) || (newData.id is string && newData.id == guestId))
        && (!changed.hasAny(['name']) || (newData.name is string && newData.name.size() > 0 && newData.name.size() < 120))
        && (!changed.hasAny(['slots']) || (newData.slots is number && newData.slots in [1,2]));
    }

    match /guests/{guestId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && guestCreateOk(request.resource.data, guestId);
      allow update: if isAdmin() && guestUpdateOk(request.resource.data, resource.data, guestId);
    }

    // ---------------- guestcheckins (VIP + temp-guest arrivals) ----------------
    function guestCheckinCreateOk(d, gcId) {
      return d.keys().hasOnly(['id','refId','name','type','date','count','terminal','timestamp'])
        && d.id is string && d.id == gcId
        && d.refId is string
        && d.name is string && d.name.size() < 120
        && d.type in ['vip','temp']
        && isDateish(d.date)
        && d.count is number && d.count in [1,2]
        && (!('terminal' in d) || (d.terminal is string && d.terminal.size() < 100))
        && isDateish(d.timestamp);
    }

    function guestCheckinUpdateOk(newData, oldData, gcId) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['id']) || (newData.id is string && newData.id == gcId))
        && (!changed.hasAny(['count']) || (newData.count is number && newData.count in [1,2]))
        && (!changed.hasAny(['type']) || newData.type in ['vip','temp']);
    }

    match /guestcheckins/{gcId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && guestCheckinCreateOk(request.resource.data, gcId);
      allow update: if isAdmin() && guestCheckinUpdateOk(request.resource.data, resource.data, gcId);
    }

    // ---------------- memberLog (admin action audit trail) ----------------
    function memberLogCreateOk(d, logId) {
      return d.keys().hasOnly(['id','memberId','label','terminal','timestamp'])
        && d.id is string && d.id == logId
        && d.memberId is string
        && d.label is string && d.label.size() < 300
        && (!('terminal' in d) || (d.terminal is string && d.terminal.size() < 100))
        && isDateish(d.timestamp);
    }

    function memberLogUpdateOk(newData, oldData, logId) {
      let changed = newData.diff(oldData).affectedKeys();
      return !changed.hasAny(['id']) || (newData.id is string && newData.id == logId);
    }

    match /memberLog/{logId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && memberLogCreateOk(request.resource.data, logId);
      allow update: if isAdmin() && memberLogUpdateOk(request.resource.data, resource.data, logId);
    }

    // ---------------- promotions (shown on the public home page; edited by admin only) ----------------
    function promotionOk(d, promoId) {
      return d.keys().hasOnly(['id','title','body','order','active','expiresAt','createdAt'])
        && d.id is string && d.id == promoId
        && d.title is string && d.title.size() > 0 && d.title.size() < 120
        && (!('body' in d) || (d.body is string && d.body.size() < 2000))
        && (!('order' in d) || d.order is number)
        && (!('active' in d) || d.active is bool)
        && (!('expiresAt' in d) || d.expiresAt == null || isDateishBounded(d.expiresAt, 40))
        && (!('createdAt' in d) || isDateishBounded(d.createdAt, 40));
    }

    match /promotions/{promoId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && promotionOk(request.resource.data, promoId);
      allow delete: if isAdmin();
    }

    // ---------------- settings (single 'main' doc: prices, days, terminals) ----------------
    function settingsWriteOk(d) {
      return d.keys().hasOnly(['eventName','singlePrice','couplePrice','activeDays','knownTerminals'])
        && (!('eventName' in d) || (d.eventName is string && d.eventName.size() < 100))
        && (!('singlePrice' in d) || d.singlePrice is string)
        && (!('couplePrice' in d) || d.couplePrice is string)
        && (!('activeDays' in d) || d.activeDays is string)
        && (!('knownTerminals' in d) || d.knownTerminals is list);
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && settingsWriteOk(request.resource.data);
    }
  }
}
