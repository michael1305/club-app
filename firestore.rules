rules_version = '2';

// Firestore security rules for the club-app-8f954 project.
//
// Access model (2026-09): the club owner signs in to the admin app with
// email/password (isAdmin() below) and is the only one who can list, read or
// delete data. Public pages (register.html, user.html) use an anonymous session
// and can only: read ONE member by id, self-register, change their own photo,
// look up/claim a phone number in the phones index, read their own
// members/{id}/checkins history, and read the promotions list.
//
// What THIS file adds: every `create`/`update` is validated against the
// exact field shapes the app actually writes, so a request that doesn't
// come through the app's own UI (e.g. a raw API call) can no longer:
//   - set a document's `id` field to anything other than its own doc key
//     (this field is what several onclick handlers embed into inline JS —
//     letting it diverge from the doc key was a second-order injection risk)
//   - set balance/vipSlots/quantity/amount/count to a non-numeric or
//     out-of-range value
//   - set `photo` to anything other than a real base64 image data URL
//   - inject arbitrary extra fields onto a brand-new document
//
// Updates are validated leniently (only the fields a given write actually
// changes are checked, via diff().affectedKeys()) specifically so a
// legitimate small edit (e.g. just updating `balance`) can never be
// rejected because of some unrelated, pre-existing field already sitting
// on that document — this trades a little strictness for not risking
// breakage of real, already-stored records.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // SECURITY: every allowlist below is by Firebase Auth UID, never by email.
    // Anyone can sign up a new email/password account through the public API key, so an
    // email-based allowlist lets a stranger claim any listed address that has no Auth user
    // yet (this was actually open for one contest-admin address until 2026-11-23).
    // A UID only exists once the real user was created, so it cannot be claimed.
    // To add someone: create the user FIRST (Firebase console -> Authentication -> Users),
    // copy its "User UID", add it to the list with a comment saying who it is, deploy rules.
    function hasUid(uids) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid in uids;
    }

    // Club admins (admin.html). Phone-number admins log in as <phone>@club-admin.local.
    function isAdmin() {
      return hasUid([
        '3RdIeBqefGeVKvkE1H7JoG31hK12',   // info@av.co.il
        'HO0dyP1wtaP2FH4ymmH77idoHCy2',   // 0523536536@club-admin.local
        'EhAQXpFKXgaf9HDeKlyy5BbPgym1',   // 0524444500@club-admin.local
        'EMVUf7TXgMga31DjgRu5zECpXS92',   // 0547448240@club-admin.local
        'gTOX6beyRGQr0n7TS41YqpU8CZw2',   // 0528588408@club-admin.local
        'F7VHcyKWTIZ4snKIOVuWhA4002C2'    // TEMPORARY google-review@club-admin.local (store reviewers) - REMOVE right after Google Play production approval (~2026-11-26), then delete that Auth user
      ]);
    }

    // Ids the app generates (generateId / genId) are lowercase base36; old ids may also hold
    // '_', '-' or '.'. Ids are embedded in inline onclick JS in the admin app, so a doc key
    // with quotes, brackets or spaces would be a stored-XSS vector: never allow one.
    function safeId(id) {
      return id is string && id.matches('^[A-Za-z0-9_.-]{1,100}$');
    }

    // The app always writes dates as plain JS strings (new Date().toISOString()),
    // but Firestore itself can also hold a native Timestamp type for the same kind
    // of value — accepting either avoids rejecting a legitimate write just because
    // of which of the two equivalent representations it happens to use.
    function isDateish(v) {
      return v is timestamp || v is string;
    }
    function isDateishBounded(v, maxLen) {
      return v is timestamp || (v is string && v.size() < maxLen);
    }

    // ---------------- members ----------------
    function memberCreateOk(d, memberId) {
      return d.keys().hasOnly(['id','name','phone','email','birthDate','photo','balance','vipSlots','marathonSlots','days','nfcTag','createdAt','registeredSelf','lastBirthdayCheckinWeek'])
        && d.id is string && d.id == memberId
        && d.name is string && d.name.size() > 0 && d.name.size() < 120
        && (!('phone' in d) || (d.phone is string && d.phone.size() < 40))
        && (!('email' in d) || (d.email is string && d.email.size() < 200))
        && (!('birthDate' in d) || isDateishBounded(d.birthDate, 20))
        && (!('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() < 900000 && d.photo.matches('^data:image/(png|jpe?g|gif|webp);base64,[A-Za-z0-9+/]+=*$')))
        && (!('balance' in d) || (d.balance is number && d.balance >= 0 && d.balance < 100000))
        && (!('vipSlots' in d) || (d.vipSlots is number && d.vipSlots in [0,1,2,3]))
        && (!('marathonSlots' in d) || (d.marathonSlots is number && d.marathonSlots in [0,1,2,3]))
        && (!('days' in d) || (d.days is list && d.days.size() <= 7 && d.days.hasOnly([0,1,2,3,4,5,6])))
        && (!('nfcTag' in d) || d.nfcTag == null || (d.nfcTag is string && d.nfcTag.size() < 500))
        && (!('createdAt' in d) || isDateishBounded(d.createdAt, 40))
        && (!('registeredSelf' in d) || d.registeredSelf is bool)
        && (!('lastBirthdayCheckinWeek' in d) || isDateishBounded(d.lastBirthdayCheckinWeek, 20));
    }

    function memberUpdateOk(newData, oldData, memberId) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['id']) || (newData.id is string && newData.id == memberId))
        && (!changed.hasAny(['name']) || (newData.name is string && newData.name.size() > 0 && newData.name.size() < 120))
        && (!changed.hasAny(['phone']) || (newData.phone is string && newData.phone.size() < 40))
        && (!changed.hasAny(['email']) || (newData.email is string && newData.email.size() < 200))
        && (!changed.hasAny(['birthDate']) || isDateishBounded(newData.birthDate, 20))
        && (!changed.hasAny(['photo']) || newData.photo == null || (newData.photo is string && newData.photo.size() < 900000 && newData.photo.matches('^data:image/(png|jpe?g|gif|webp);base64,[A-Za-z0-9+/]+=*$')))
        && (!changed.hasAny(['balance']) || (newData.balance is number && newData.balance >= 0 && newData.balance < 100000))
        && (!changed.hasAny(['vipSlots']) || (newData.vipSlots is number && newData.vipSlots in [0,1,2,3]))
        && (!changed.hasAny(['marathonSlots']) || (newData.marathonSlots is number && newData.marathonSlots in [0,1,2,3]))
        && (!changed.hasAny(['days']) || (newData.days is list && newData.days.size() <= 7 && newData.days.hasOnly([0,1,2,3,4,5,6])))
        && (!changed.hasAny(['nfcTag']) || newData.nfcTag == null || (newData.nfcTag is string && newData.nfcTag.size() < 500))
        && (!changed.hasAny(['registeredSelf']) || newData.registeredSelf is bool)
        && (!changed.hasAny(['lastBirthdayCheckinWeek']) || isDateishBounded(newData.lastBirthdayCheckinWeek, 20));
    }

    // Public (anonymous) visitors can: read ONE member by id (their own card link),
    // self-register (balance 0, no VIP/NFC), and change only their own photo.
    // Only the admin can list or change anything else. A signed-in holder of the
    // (unguessable) member id may delete the member ONLY when there is no money left on
    // the card (App Store requires in-app deletion; paid balances must go through the
    // team via deletionRequests below). The admin can always delete.
    match /members/{memberId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.get('balance', 0) == 0);
      allow create: if safeId(memberId) && (isAdmin() && memberCreateOk(request.resource.data, memberId)
        || signedIn() && memberCreateOk(request.resource.data, memberId)
           && request.resource.data.registeredSelf == true
           && request.resource.data.get('balance', 0) == 0
           && !('vipSlots' in request.resource.data)
           && !('nfcTag' in request.resource.data));
      allow update: if isAdmin() && memberUpdateOk(request.resource.data, resource.data, memberId)
        || signedIn() && memberUpdateOk(request.resource.data, resource.data, memberId)
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo']);

      // A member's own check-in history (copy of top-level checkins, written by the admin app).
      match /checkins/{checkinId} {
        allow read: if signedIn();
        allow create, update: if isAdmin();
        // removed together with the member's own account (only when nothing is owed)
        allow delete: if isAdmin() || (signedIn()
          && get(/databases/$(database)/documents/members/$(memberId)).data.get('balance', 0) == 0);
      }
    }

    // A member with a remaining balance cannot self-delete; they send a request that the
    // team reviews in the back office (settings). Doc id = the member id.
    match /deletionRequests/{reqId} {
      allow create, update: if signedIn() && safeId(reqId)
        && request.resource.data.keys().hasOnly(['memberId','createdAt'])
        && request.resource.data.memberId is string && request.resource.data.memberId == reqId
        && isDateishBounded(request.resource.data.createdAt, 40)
        && exists(/databases/$(database)/documents/members/$(reqId));
      // get: the member's own card page checks for a pending request so the card is
      // hidden from them right away (doc holds only memberId + createdAt; ids are unguessable).
      allow get: if signedIn();
      allow list, delete: if isAdmin();
    }

    // Duplicate-phone index used by register.html: anyone can check whether a phone is
    // already registered / claim it once. It holds NO member id on purpose (a phone must
    // never lead to a member profile); only the admin can change or remove entries.
    match /phones/{phoneKey} {
      allow get: if signedIn();
      allow create: if signedIn() && phoneKey.matches('^[0-9]{1,20}$')
        && request.resource.data.keys().hasOnly(['createdAt']);
      allow list, update: if isAdmin();
      allow delete: if signedIn();   // removed when a member deletes their own account
    }

    // ---------------- payments ----------------
    function paymentCreateOk(d, paymentId) {
      return d.keys().hasOnly(['id','memberId','quantity','amount','paymentMethod','note','terminal','date','wantsInvoice'])
        && d.id is string && d.id == paymentId
        && d.memberId is string
        && d.quantity is number && d.quantity > 0 && d.quantity <= 1000
        && d.amount is number && d.amount >= 0 && d.amount <= 100000
        && (!('paymentMethod' in d) || d.paymentMethod in ['cash','credit'])
        && (!('note' in d) || (d.note is string && d.note.size() < 500))
        && (!('terminal' in d) || (d.terminal is string && d.terminal.size() < 100))
        && (!('wantsInvoice' in d) || d.wantsInvoice is bool)
        && isDateish(d.date);
    }

    function paymentUpdateOk(newData, oldData, paymentId) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['id']) || (newData.id is string && newData.id == paymentId))
        && (!changed.hasAny(['memberId']) || newData.memberId is string)
        && (!changed.hasAny(['quantity']) || (newData.quantity is number && newData.quantity > 0 && newData.quantity <= 1000))
        && (!changed.hasAny(['amount']) || (newData.amount is number && newData.amount >= 0 && newData.amount <= 100000))
        && (!changed.hasAny(['paymentMethod']) || newData.paymentMethod in ['cash','credit'])
        && (!changed.hasAny(['note']) || (newData.note is string && newData.note.size() < 500))
        && (!changed.hasAny(['terminal']) || (newData.terminal is string && newData.terminal.size() < 100));
    }

    match /payments/{paymentId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && paymentCreateOk(request.resource.data, paymentId);
      allow update: if isAdmin() && paymentUpdateOk(request.resource.data, resource.data, paymentId);
    }

    // ---------------- checkins ----------------
    function checkinCreateOk(d, checkinId) {
      return d.keys().hasOnly(['id','memberId','entryType','terminal','timestamp'])
        && d.id is string && d.id == checkinId
        && d.memberId is string
        && d.entryType in ['single','couple','birthday','vip-single','vip-couple','vip-triple']
        && (!('terminal' in d) || (d.terminal is string && d.terminal.size() < 100))
        && isDateish(d.timestamp);
    }

    function checkinUpdateOk(newData, oldData, checkinId) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['id']) || (newData.id is string && newData.id == checkinId))
        && (!changed.hasAny(['memberId']) || newData.memberId is string)
        && (!changed.hasAny(['entryType']) || newData.entryType in ['single','couple','birthday','vip-single','vip-couple','vip-triple'])
        && (!changed.hasAny(['terminal']) || (newData.terminal is string && newData.terminal.size() < 100));
    }

    match /checkins/{checkinId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && checkinCreateOk(request.resource.data, checkinId);
      allow update: if isAdmin() && checkinUpdateOk(request.resource.data, resource.data, checkinId);
    }

    // ---------------- guests (temporary, 48h) ----------------
    function guestCreateOk(d, guestId) {
      return d.keys().hasOnly(['id','name','slots','days','createdAt','expiresAt'])
        && d.id is string && d.id == guestId
        && d.name is string && d.name.size() > 0 && d.name.size() < 120
        && d.slots is number && d.slots in [1,2,3]
        && (!('days' in d) || (d.days is list && d.days.size() <= 7 && d.days.hasOnly([0,1,2,3,4,5,6])))
        && isDateish(d.createdAt)
        && isDateish(d.expiresAt);
    }

    function guestUpdateOk(newData, oldData, guestId) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['id']) || (newData.id is string && newData.id == guestId))
        && (!changed.hasAny(['name']) || (newData.name is string && newData.name.size() > 0 && newData.name.size() < 120))
        && (!changed.hasAny(['slots']) || (newData.slots is number && newData.slots in [1,2,3]))
        && (!changed.hasAny(['days']) || (newData.days is list && newData.days.size() <= 7 && newData.days.hasOnly([0,1,2,3,4,5,6])));
    }

    match /guests/{guestId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && guestCreateOk(request.resource.data, guestId);
      allow update: if isAdmin() && guestUpdateOk(request.resource.data, resource.data, guestId);
    }

    // ---------------- guestcheckins (VIP + temp-guest arrivals) ----------------
    function guestCheckinCreateOk(d, gcId) {
      return d.keys().hasOnly(['id','refId','name','type','date','count','terminal','timestamp'])
        && d.id is string && d.id == gcId
        && d.refId is string
        && d.name is string && d.name.size() < 120
        && d.type in ['vip','temp']
        && isDateish(d.date)
        && d.count is number && d.count in [1,2,3]
        && (!('terminal' in d) || (d.terminal is string && d.terminal.size() < 100))
        && isDateish(d.timestamp);
    }

    function guestCheckinUpdateOk(newData, oldData, gcId) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['id']) || (newData.id is string && newData.id == gcId))
        && (!changed.hasAny(['count']) || (newData.count is number && newData.count in [1,2,3]))
        && (!changed.hasAny(['type']) || newData.type in ['vip','temp']);
    }

    match /guestcheckins/{gcId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && guestCheckinCreateOk(request.resource.data, gcId);
      allow update: if isAdmin() && guestCheckinUpdateOk(request.resource.data, resource.data, gcId);
    }

    // ---------------- memberLog (admin action audit trail) ----------------
    function memberLogCreateOk(d, logId) {
      return d.keys().hasOnly(['id','memberId','label','terminal','timestamp'])
        && d.id is string && d.id == logId
        && d.memberId is string
        && d.label is string && d.label.size() < 300
        && (!('terminal' in d) || (d.terminal is string && d.terminal.size() < 100))
        && isDateish(d.timestamp);
    }

    function memberLogUpdateOk(newData, oldData, logId) {
      let changed = newData.diff(oldData).affectedKeys();
      return !changed.hasAny(['id']) || (newData.id is string && newData.id == logId);
    }

    match /memberLog/{logId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && memberLogCreateOk(request.resource.data, logId);
      allow update: if isAdmin() && memberLogUpdateOk(request.resource.data, resource.data, logId);
    }

    // ---------------- promotions (shown on the public home page; edited by admin only) ----------------
    function promotionOk(d, promoId) {
      return d.keys().hasOnly(['id','title','body','order','active','expiresAt','createdAt'])
        && d.id is string && d.id == promoId
        && d.title is string && d.title.size() > 0 && d.title.size() < 120
        && (!('body' in d) || (d.body is string && d.body.size() < 2000))
        && (!('order' in d) || d.order is number)
        && (!('active' in d) || d.active is bool)
        && (!('expiresAt' in d) || d.expiresAt == null || isDateishBounded(d.expiresAt, 40))
        && (!('createdAt' in d) || isDateishBounded(d.createdAt, 40));
    }

    match /promotions/{promoId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && promotionOk(request.resource.data, promoId);
      allow delete: if isAdmin();
    }

    // ---------------- dance-site landing pages (site-admin.html) ----------------
    // Public content of dance.gadibitton.co.il/beginners.html and harkadot.html: anyone may read
    // (the pages fetch it anonymously over REST). Editing is a SEPARATE login from the club:
    // only these site editors, and club admins are deliberately NOT included. Editors sign in
    // with a phone number mapped to <phone>@site-editor.local (see site-admin.html).
    // To add an editor: create the user in Firebase console -> Authentication -> Users,
    // then add its UID below and deploy rules.
    function siteEditor() {
      return hasUid([
        '2WDjPCdfDDbMgKmJpjw3wmadFPA3',   // 0528114026@site-editor.local
        '1cX8A1nCaLYPsqo0bd8zTUkc68y2',   // 0547448240@site-editor.local
        'ifY1wNdS7getKaqDpVMDfghEZpH2'    // 0524444500@site-editor.local
      ]);
    }

    match /sitePages/{pageId} {
      allow read: if true;
      allow write: if siteEditor()
        && pageId in ['beginners', 'harkadot']
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is string && request.resource.data.data.size() < 300000
        && isDateishBounded(request.resource.data.updatedAt, 40)
        && (!('updatedBy' in request.resource.data) || (request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() < 200));
    }

    // Pictures uploaded from site-admin.html, referenced from page content as "img:<id>".
    match /siteImages/{imgId} {
      allow read: if true;
      allow create, update: if siteEditor()
        && imgId.size() < 80
        && request.resource.data.keys().hasOnly(['src', 'updatedAt'])
        && request.resource.data.src is string && request.resource.data.src.size() < 900000
        && request.resource.data.src.matches('^data:image/(png|jpe?g|webp);base64,[A-Za-z0-9+/]+=*$')
        && isDateishBounded(request.resource.data.updatedAt, 40);
      allow delete: if siteEditor();
    }

    // ---------------- annual dance contest (מצעד הריקודים) ----------------
    // Stage 1: instructors log in with SMS (Micropay) on contest.html. SMS + code checking
    // run on a small Cloudflare Worker (contest-api/), which reads/writes these collections signed
    // in as ONE dedicated bot user. After login, instructors also read/write their own contestPicks
    // doc directly (contestOwner below), so the page works on networks that block workers.dev.
    function contestBot() {
      return hasUid(['JGlxshuLiZQfF9mEzCITSFkhr983']);   // contest-bot@club-contest.local
    }

    // Who may use contest-admin.html: every club admin, plus contest-only admins who get NO
    // access to members/payments/etc. They log in through the same club admin login
    // (<phone>@club-admin.local). Access is decided only here, by UID.
    function contestAdmin() {
      // Contest-only admins by UID (create the Auth user first, confirm it is really theirs,
      // then add the UID here).
      return isAdmin() || hasUid([
        'llzwbBrU7zO8FhyWmKbiDN7nCuS2'    // Gil, 0528114026@club-admin.local (created 2026-11-24, confirmed by owner)
      ]);
    }

    // Allowlist of instructors who may log in. Doc id = phone (05XXXXXXXX). Holds names + phones,
    // so never public.
    match /contestInstructors/{phone} {
      allow read: if contestBot() || contestAdmin();
      allow write: if (contestBot() || contestAdmin())
        && phone.matches('^05[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['name', 'type'])
        && request.resource.data.name is string && request.resource.data.name.size() < 120;
      allow delete: if contestAdmin();
    }

    // One-time SMS codes (hashed). Bot only.
    match /contestOtps/{phone} {
      allow read, write: if contestBot() && phone.matches('^05[0-9]{8}$');
    }

    // Which Firebase user is which instructor. Written ONLY by the bot, after the instructor proved
    // their phone with the SMS code; the Worker creates that user (unguessable email) and hands its
    // password to the instructor's browser. A user someone signs up by themselves has no doc here,
    // so it gets no access.
    match /contestAuth/{uid} {
      allow read: if contestBot() || (request.auth != null && request.auth.uid == uid);
      allow write: if contestBot()
        && request.resource.data.keys().hasOnly(['phone', 'name'])
        && request.resource.data.phone is string && request.resource.data.phone.matches('^05[0-9]{8}$')
        && request.resource.data.name is string && request.resource.data.name.size() < 120;
    }
    function contestOwner(phone) {
      return request.auth != null
        && exists(/databases/$(database)/documents/contestAuth/$(request.auth.uid))
        && get(/databases/$(database)/documents/contestAuth/$(request.auth.uid)).data.phone == phone;
    }
    function contestStage1Open() {
      return !exists(/databases/$(database)/documents/contestConfig/main)
        || get(/databases/$(database)/documents/contestConfig/main).data.get('stage1Open', true) != false;
    }

    // An instructor's picks. Doc id = phone. Written by the instructor directly (while stage 1 is
    // open) or by the bot; the admin reads them.
    match /contestPicks/{phone} {
      allow read: if contestBot() || contestAdmin() || contestOwner(phone);
      allow write: if (contestBot() || (contestOwner(phone) && contestStage1Open()))
        && phone.matches('^05[0-9]{8}$')
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() < 120))
        && request.resource.data.keys().hasOnly(['name', 'picks', 'extra', 'updatedAt'])
        && request.resource.data.picks is list && request.resource.data.picks.size() <= 200
        // extra: dances typed in by hand, one text per style
        && (!('extra' in request.resource.data) || (request.resource.data.extra is map
            && request.resource.data.extra.keys().hasOnly(['circle', 'couple', 'line'])
            && request.resource.data.extra.get('circle', '').size() <= 2000
            && request.resource.data.extra.get('couple', '').size() <= 2000
            && request.resource.data.extra.get('line', '').size() <= 2000))
        && isDateishBounded(request.resource.data.updatedAt, 40);
      allow delete: if contestAdmin();
    }

    // Contest settings, public so contest.html / the stage-2 voting page can read them:
    // stage1Open (bool), finalists (dance ids chosen by the admin for stage 2).
    match /contestConfig/{docId} {
      allow read: if true;
      // 'vote': stage-2 public voting — open (bool) + clips {danceId: {yt, s}} (YouTube id + start second)
      allow write: if contestAdmin() && docId == 'vote'
        && request.resource.data.keys().hasOnly(['open', 'clips', 'updatedAt'])
        && (!('open' in request.resource.data) || request.resource.data.open is bool)
        && (!('clips' in request.resource.data) || (request.resource.data.clips is map && request.resource.data.clips.size() <= 200))
        && (!('updatedAt' in request.resource.data) || isDateishBounded(request.resource.data.updatedAt, 40));
      allow write: if contestAdmin() && docId == 'main'
        && request.resource.data.keys().hasOnly(['stage1Open', 'finalists', 'updatedAt'])
        && (!('stage1Open' in request.resource.data) || request.resource.data.stage1Open is bool)
        && (!('finalists' in request.resource.data) || (request.resource.data.finalists is list && request.resource.data.finalists.size() <= 200))
        && (!('updatedAt' in request.resource.data) || isDateishBounded(request.resource.data.updatedAt, 40));
    }

    // Stage 2 voters (vote.html). Doc id = phone, verified by SMS in the Worker. Bot writes,
    // admin reads (results, prize draw).
    match /contestVoters/{phone} {
      allow read: if contestBot() || contestAdmin();
      allow write: if contestBot()
        && phone.matches('^05[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['name', 'city', 'email', 'verifiedAt', 'picks', 'votedAt', 'test'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
        && request.resource.data.city is string && request.resource.data.city.size() <= 60
        && (!('picks' in request.resource.data) || (request.resource.data.picks is map
            && request.resource.data.picks.keys().hasOnly(['circle', 'couple', 'line'])));
      allow delete: if contestAdmin();
    }
    // Test phones for the vote: no real SMS (code shown on screen), votes marked test.
    match /contestVoteTesters/{phone} {
      allow read: if contestBot() || contestAdmin();
      allow write: if (contestBot() || contestAdmin()) && phone.matches('^05[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['name']) && request.resource.data.name is string && request.resource.data.name.size() < 80;
      allow delete: if contestAdmin();
    }
    // Song clips uploaded in contest-admin (15s mp3, base64). Public so vote.html can play them.
    match /contestClips/{danceId} {
      allow read: if true;
      allow write: if contestAdmin() && danceId.matches('^d[0-9]{2,3}$')
        && request.resource.data.keys().hasOnly(['data', 'name', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 900000
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
      allow delete: if contestAdmin();
    }
    match /contestVoteOtps/{phone} {
      allow read, write: if contestBot() && phone.matches('^05[0-9]{8}$');
    }
    match /contestVoteLimits/{id} {
      allow read, write: if contestBot();
    }

    // ---------------- settings (single 'main' doc: prices, days, terminals) ----------------
    function settingsWriteOk(d) {
      return d.keys().hasOnly(['eventName','singlePrice','couplePrice','activeDays','knownTerminals'])
        && (!('eventName' in d) || (d.eventName is string && d.eventName.size() < 100))
        && (!('singlePrice' in d) || d.singlePrice is string)
        && (!('couplePrice' in d) || d.couplePrice is string)
        && (!('activeDays' in d) || d.activeDays is string)
        && (!('knownTerminals' in d) || d.knownTerminals is list);
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && settingsWriteOk(request.resource.data);
    }
  }
}
